<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="numeric" version="1.0" default-locale="en-US">
  <info>
    <title>Computers and Concrete (Techno-Press 2026) - Mendeley custom</title>
    <title-short>Comput. Concr. (Techno-Press custom)</title-short>
    <id>https://example.org/styles/computers-and-concrete-techno-press-2026-custom</id>
    <link href="https://example.org/styles/computers-and-concrete-techno-press-2026-custom" rel="self"/>
    <link href="https://www.techno-press.com/documents/authors-guide" rel="documentation"/>
    <author><name>Custom draft for Computers and Concrete submission</name></author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Numeric in-text citations, bibliography in citation order, APA-like references without italics, modeled on the Techno-Press 2026 example. A user-created draft, not an official publisher CSL. Apply font and hyperlinks in Word.</summary>
    <updated>2026-11-04T00:00:00+00:00</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="author-year">
    <group delimiter=" ">
      <text macro="author"/>
      <text macro="year" prefix="(" suffix=")."/>
    </group>
  </macro>

  <macro name="doi-or-url">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/" suffix="."/>
      </if>
      <else-if variable="URL">
        <text variable="URL" suffix="."/>
      </else-if>
    </choose>
  </macro>

  <macro name="journal-details">
    <group delimiter=", ">
      <text variable="container-title"/>
      <group>
        <text variable="volume"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="bibliography-entry">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <text macro="author-year"/>
          <text variable="title" suffix="."/>
          <group delimiter=" " >
            <text macro="journal-details" suffix="."/>
            <text macro="doi-or-url"/>
          </group>
        </group>
      </if>
      <else-if type="paper-conference">
        <group delimiter=" ">
          <text macro="author-year"/>
          <text variable="title" suffix="."/>
          <group delimiter=", " suffix=".">
            <text variable="container-title"/>
            <text variable="event-place"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="doi-or-url"/>
        </group>
      </else-if>
      <else-if type="book">
        <group delimiter=" ">
          <text macro="author-year"/>
          <text variable="title" suffix="."/>
          <group delimiter=", " suffix=".">
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="doi-or-url"/>
        </group>
      </else-if>
      <else-if type="chapter">
        <group delimiter=" ">
          <text macro="author-year"/>
          <text variable="title" suffix="."/>
          <group delimiter=", " suffix=".">
            <text variable="container-title"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
            <text variable="page"/>
          </group>
          <text macro="doi-or-url"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=" ">
          <text macro="author-year"/>
          <text variable="title" suffix="."/>
          <group delimiter=", " suffix=".">
            <text variable="genre"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="doi-or-url"/>
        </group>
      </else-if>
      <else>
        <group delimiter=" ">
          <text macro="author-year"/>
          <text variable="title" suffix="."/>
          <group delimiter=", " suffix=".">
            <text variable="number" prefix="Report No. "/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="doi-or-url"/>
        </group>
      </else>
    </choose>
  </macro>

  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <text macro="bibliography-entry"/>
    </layout>
  </bibliography>
</style>
